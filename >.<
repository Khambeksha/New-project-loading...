<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Student result dashboard</title>
<style>
:root{--bg:#f7f6f3;--card:#fff;--ink:#1a1a19;--ink2:#5b5a56;--line:#e1e0d9;--blue:#2a78d6;--track:#ecebe6;--okbg:#e3f4e3;--ok:#0a6b0a;--badbg:#fbe5e5;--bad:#a32d2d;--warnbg:#fdf1d6;--warn:#7a5200}
@media (prefers-color-scheme:dark){:root{--bg:#1a1a19;--card:#242422;--ink:#f0efec;--ink2:#c3c2b7;--line:#383835;--blue:#3987e5;--track:#383835;--okbg:#17361a;--ok:#8fd48f;--badbg:#401c1c;--bad:#f0a0a0;--warnbg:#3b2f10;--warn:#f0cf80}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5}
main{max-width:560px;margin:0 auto;padding:20px 16px 40px}
h1{font-size:22px;font-weight:500;margin:0 0 4px}
.sub{color:var(--ink2);font-size:14px;margin:0 0 18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:14px}
label{display:block;font-size:13px;color:var(--ink2);margin-bottom:4px}
input{width:100%;box-sizing:border-box;padding:10px 12px;font-size:16px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink)}
.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
button{margin-top:12px;width:100%;padding:11px;font-size:15px;font-weight:500;border:0;border-radius:8px;background:var(--blue);color:#fff;cursor:pointer}
.err{color:var(--bad);font-size:13px;margin-top:8px;min-height:18px}
.head{display:flex;justify-content:space-between;align-items:center;gap:12px}
.name{font-size:20px;font-weight:500}
.meta{font-size:13px;color:var(--ink2)}
.badge{padding:4px 12px;border-radius:6px;font-size:13px;font-weight:500}
.pass{background:var(--okbg);color:var(--ok)}
.fail{background:var(--badbg);color:var(--bad)}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.stat{background:var(--bg);border-radius:8px;padding:10px 12px}
.stat b{display:block;font-size:22px;font-weight:500}
.stat span{font-size:12px;color:var(--ink2)}
.bar{margin:12px 0}
.bt{display:flex;justify-content:space-between;font-size:14px;margin-bottom:4px}
.track{height:10px;background:var(--track);border-radius:5px;overflow:hidden}
.fill{height:100%;border-radius:5px;background:var(--blue)}
.fill.low{background:#d03b3b}
.note{margin-top:10px;padding:10px 12px;border-radius:8px;font-size:14px}
.warn{background:var(--warnbg);color:var(--warn)}
.hidden{display:none}
.hint{font-size:12px;color:var(--ink2);margin-top:10px}
</style>
</head>
<body>
<main>
<h1>Student result dashboard</h1>
<p class="sub">Enter your roll number and name to see your result.</p>

<div class="card">
  <div class="row">
    <div><label for="roll">Roll number</label><input id="roll" inputmode="numeric" placeholder="3"></div>
    <div><label for="nm">First name</label><input id="nm" placeholder="Bikash"></div>
  </div>
  <button id="go">View my result</button>
  <div class="err" id="err"></div>
  <div class="hint">Try roll 1 to 6 with the matching sample name.</div>
</div>

<div id="out" class="hidden">
  <div class="card">
    <div class="head">
      <div><div class="name" id="oName"></div><div class="meta" id="oMeta"></div></div>
      <div class="badge" id="oBadge"></div>
    </div>
    <div class="stats">
      <div class="stat"><b id="oRank"></b><span>Class rank</span></div>
      <div class="stat"><b id="oGrade"></b><span>Grade</span></div>
      <div class="stat"><b id="oTotal"></b><span>Total marks</span></div>
      <div class="stat"><b id="oAvg"></b><span>Average</span></div>
    </div>
  </div>
  <div class="card">
    <div class="meta">Subject marks (pass mark 50)</div>
    <div id="bars"></div>
    <div id="notes"></div>
  </div>
</div>
</main>

<script>
var PASS = 50, MINATT = 75, SUBJ = ["Sci", "Eng", "Soc", "Comp"];

// Edit this list with your own students
var S = [
  {roll:1, name:"Aarav",  section:"A", attendance:95, Sci:88, Eng:79, Soc:85, Comp:96},
  {roll:2, name:"Sita",   section:"A", attendance:92, Sci:91, Eng:94, Soc:88, Comp:82},
  {roll:3, name:"Bikash", section:"B", attendance:78, Sci:58, Eng:71, Soc:66, Comp:73},
  {roll:4, name:"Anita",  section:"B", attendance:88, Sci:82, Eng:88, Soc:90, Comp:75},
  {roll:5, name:"Rohan",  section:"B", attendance:65, Sci:52, Eng:60, Soc:55, Comp:48},
  {roll:6, name:"Priya",  section:"A", attendance:98, Sci:94, Eng:91, Soc:93, Comp:98}
];

function grade(a){
  return a>=90 ? "A+" : a>=80 ? "A" : a>=70 ? "B" : a>=60 ? "C" : a>=PASS ? "D" : "F";
}

S.forEach(function(s){
  s.total = SUBJ.reduce(function(t,k){ return t + s[k]; }, 0);
  s.avg = s.total / SUBJ.length;
});
var ranked = S.slice().sort(function(a,b){ return b.total - a.total; });
S.forEach(function(s){ s.rank = ranked.indexOf(s) + 1; });

function $(id){ return document.getElementById(id); }

function show(s){
  var failed = SUBJ.filter(function(k){ return s[k] < PASS; });
  $("oName").textContent = s.name;
  $("oMeta").textContent = "Roll " + s.roll + " · Section " + s.section + " · Attendance " + s.attendance + "%";
  $("oBadge").textContent = failed.length ? "Fail" : "Pass";
  $("oBadge").className = "badge " + (failed.length ? "fail" : "pass");
  $("oRank").textContent = "#" + s.rank + " of " + S.length;
  $("oGrade").textContent = grade(s.avg);
  $("oTotal").textContent = s.total + " / " + SUBJ.length * 100;
  $("oAvg").textContent = s.avg.toFixed(1);

  $("bars").innerHTML = SUBJ.map(function(k){
    return '<div class="bar"><div class="bt"><span>' + k + '</span><span>' + s[k] + '</span></div>' +
           '<div class="track"><div class="fill' + (s[k] < PASS ? ' low' : '') + '" style="width:' + s[k] + '%"></div></div></div>';
  }).join("");

  var n = "";
  if (failed.length) n += '<div class="note warn">Needs improvement in: ' + failed.join(", ") + '.</div>';
  if (s.attendance < MINATT) n += '<div class="note warn">Attendance is below the ' + MINATT + '% minimum.</div>';
  if (!n) n = '<div class="note pass">Passed in all subjects with good attendance.</div>';
  $("notes").innerHTML = n;
  $("out").className = "";
}

$("go").onclick = function(){
  var r = parseInt($("roll").value, 10);
  var nm = $("nm").value.trim().toLowerCase();
  var s = S.filter(function(x){ return x.roll === r && x.name.toLowerCase() === nm; })[0];
  if (!s) {
    $("err").textContent = "No match. Check your roll number and name.";
    $("out").className = "hidden";
    return;
  }
  $("err").textContent = "";
  show(s);
};
</script>
</body>
</html>
